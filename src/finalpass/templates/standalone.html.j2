{% extends "base.html.j2" %}
{% import "_macros.html.j2" as macros %}

{% block header_badge %}
{{ macros.badge(report.summary.overall_pass|verdict_label(false), report.summary.overall_pass|verdict_class(false)) }}
{% endblock %}

{% block body %}
  {% if command == "loudness" %}
  <section class="card">
    <h2>Loudness Summary</h2>
    <p class="muted">{{ report.spec.name }} — {{ report.spec.display_name }}</p>
    {{ macros.summary_stats([
      ("Overall", macros.badge(report.summary.overall_pass|verdict_label(false), report.summary.overall_pass|verdict_class(false))),
      ("Total checks", report.summary.total_checks),
      ("Passed", report.summary.passed),
      ("Failed", report.summary.failed),
      ("Skipped", report.summary.skipped),
    ]) }}
  </section>

  {% for file_report in report.files %}
    {{ macros.file_report(file_report) }}
  {% endfor %}

  {% elif command == "null" %}
  <section class="card">
    <h2>Null Summary</h2>
    {{ macros.summary_stats([
      ("Overall", macros.badge(report.summary.overall_pass|verdict_label(false), report.summary.overall_pass|verdict_class(false))),
      ("Printmaster", display_label(report.printmaster)),
      ("Printmaster source", source_summary(report.printmaster)),
      ("Stem count", report.stems|length),
      ("Window / hop / threshold", "%.0f ms / %.0f ms / %.1f dBFS"|format(report.null_test.window_ms, report.null_test.hop_ms, report.null_test.threshold_dbfs)),
    ]) }}
  </section>

  <section class="card">
    <h2>Input metadata</h2>
    <div class="section-stack">
      <div class="card card-muted">
        <h3>{{ display_label(report.printmaster) }}</h3>
        <p class="muted">{{ source_summary(report.printmaster) }}</p>
        <div class="meta-grid">
          <div class="stat"><div class="stat-label">File</div><div class="stat-value mono">{{ report.printmaster.path|basename }}</div></div>
          <div class="stat"><div class="stat-label">Sample rate</div><div class="stat-value">{{ report.printmaster.sample_rate }} Hz</div></div>
          <div class="stat"><div class="stat-label">Bit depth</div><div class="stat-value">{{ report.printmaster.bit_depth }}-bit</div></div>
          <div class="stat"><div class="stat-label">Channels</div><div class="stat-value">{{ channel_display(report.printmaster.channel_config_actual, report.printmaster.channel_count) }}</div></div>
          <div class="stat"><div class="stat-label">Duration</div><div class="stat-value">{{ report.printmaster.duration_seconds|fmt_seconds(2) }}</div></div>
        </div>
        {{ macros.source_provenance(report.printmaster) }}
      </div>
      <section class="card card-muted">
        <h3>Stems</h3>
        <div class="table-scroll">
        <table>
          <thead>
            <tr><th>Asset</th><th>Sample rate</th><th>Bit depth</th><th>Channels</th><th>Duration</th></tr>
          </thead>
          <tbody>
            {% for stem in report.stems %}
            <tr>
              <td>
                <strong>{{ display_label(stem) }}</strong>
                <div class="muted">{{ source_summary(stem) }}</div>
                <div class="filename">{{ stem.path|basename }}</div>
              </td>
              <td>{{ stem.sample_rate }} Hz</td>
              <td>{{ stem.bit_depth }}-bit</td>
              <td>{{ channel_display(stem.channel_config_actual, stem.channel_count) }}</td>
              <td>{{ stem.duration_seconds|fmt_seconds(2) }}</td>
            </tr>
            <tr>
              <td colspan="5">{{ macros.source_provenance(stem) }}</td>
            </tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
      </section>
    </div>
  </section>

  {% if report.null_test.summary %}
  <section class="card">
    <h2>Analysis Summary</h2>
    {{ macros.summary_stats([
      ("Windows total", report.null_test.summary.windows_total),
      ("Windows flagged", report.null_test.summary.windows_flagged),
      ("Flagged regions", report.null_test.summary.flagged_regions),
      ("Max residual RMS", "%.1f dBFS"|format(report.null_test.summary.max_residual_rms_dbfs)),
      ("Mean residual RMS", "%.1f dBFS"|format(report.null_test.summary.mean_residual_rms_dbfs)),
    ]) }}
  </section>
  {% endif %}

  {{ macros.analysis_window(report.null_test.analysis_window) }}
  {{ macros.flagged_timeline(timeline_lane(report.null_test.flags, sample_rate=report.printmaster.sample_rate, duration_seconds=report.printmaster.duration_seconds), "Flagged-region timeline") }}

  {% if report.null_test.flags %}
    {{ macros.flagged_table(report.null_test.flags, "Peak residual") }}
  {% endif %}
  {{ macros.errors_block(report.null_test.errors) }}

  {% elif command == "me" %}
  <section class="card">
    <h2>M&amp;E Summary</h2>
    {{ macros.summary_stats([
      ("Overall", macros.badge(report.summary.overall_pass|verdict_label(false), report.summary.overall_pass|verdict_class(false))),
      ("M&E", display_label(report.me_file)),
      ("M&E source", source_summary(report.me_file)),
      ("DX", display_label(report.dx_file)),
      ("DX source", source_summary(report.dx_file)),
      ("Window / hop / band", "%.0f ms / %.0f ms / %.0f-%.0f Hz"|format(report.me_check.window_ms, report.me_check.hop_ms, report.me_check.band_low_hz, report.me_check.band_high_hz)),
      ("Thresholds", "corr %.2f / coh %.2f / dx %.1f dBFS / me %.1f dBFS"|format(report.me_check.corr_threshold, report.me_check.coherence_threshold, report.me_check.dx_gate_dbfs, report.me_check.me_floor_dbfs)),
    ]) }}
  </section>

  <section class="card">
    <h2>Input metadata</h2>
    <div class="section-stack">
      <div class="card card-muted">
        <h3>{{ display_label(report.me_file) }}</h3>
        <p class="muted">{{ source_summary(report.me_file) }}</p>
        <div class="meta-grid">
          <div class="stat"><div class="stat-label">File</div><div class="stat-value mono">{{ report.me_file.path|basename }}</div></div>
          <div class="stat"><div class="stat-label">Sample rate</div><div class="stat-value">{{ report.me_file.sample_rate }} Hz</div></div>
          <div class="stat"><div class="stat-label">Bit depth</div><div class="stat-value">{{ report.me_file.bit_depth }}-bit</div></div>
          <div class="stat"><div class="stat-label">Channels</div><div class="stat-value">{{ channel_display(report.me_file.channel_config_actual, report.me_file.channel_count) }}</div></div>
          <div class="stat"><div class="stat-label">Duration</div><div class="stat-value">{{ report.me_file.duration_seconds|fmt_seconds(2) }}</div></div>
        </div>
        {{ macros.source_provenance(report.me_file) }}
      </div>
      <div class="card card-muted">
        <h3>{{ display_label(report.dx_file) }}</h3>
        <p class="muted">{{ source_summary(report.dx_file) }}</p>
        <div class="meta-grid">
          <div class="stat"><div class="stat-label">File</div><div class="stat-value mono">{{ report.dx_file.path|basename }}</div></div>
          <div class="stat"><div class="stat-label">Sample rate</div><div class="stat-value">{{ report.dx_file.sample_rate }} Hz</div></div>
          <div class="stat"><div class="stat-label">Bit depth</div><div class="stat-value">{{ report.dx_file.bit_depth }}-bit</div></div>
          <div class="stat"><div class="stat-label">Channels</div><div class="stat-value">{{ channel_display(report.dx_file.channel_config_actual, report.dx_file.channel_count) }}</div></div>
          <div class="stat"><div class="stat-label">Duration</div><div class="stat-value">{{ report.dx_file.duration_seconds|fmt_seconds(2) }}</div></div>
        </div>
        {{ macros.source_provenance(report.dx_file) }}
      </div>
    </div>
  </section>

  {% if report.me_check.summary %}
  <section class="card">
    <h2>Analysis Summary</h2>
    {{ macros.summary_stats([
      ("Windows total", report.me_check.summary.windows_total),
      ("Windows gated out", report.me_check.summary.windows_gated_out),
      ("Windows analyzed", report.me_check.summary.windows_analyzed),
      ("Windows flagged", report.me_check.summary.windows_flagged),
      ("Flagged regions", report.me_check.summary.flagged_regions),
      ("Max bleed score", report.me_check.summary.max_dialog_bleed_score|fmt_float(2)),
      ("Max correlation", report.me_check.summary.max_corr_abs|fmt_float(2)),
      ("Max coherence", report.me_check.summary.max_coherence_mean|fmt_float(2)),
    ]) }}
  </section>
  {% endif %}

  {{ macros.analysis_window(report.me_check.analysis_window) }}
  {{ macros.flagged_timeline(timeline_lane(report.me_check.flags, sample_rate=report.me_file.sample_rate, duration_seconds=report.me_file.duration_seconds), "Flagged-region timeline") }}

  {% if report.me_check.flags %}
    {{ macros.flagged_table(report.me_check.flags, "Bleed score") }}
  {% endif %}
  {{ macros.errors_block(report.me_check.errors) }}
  {% endif %}
{% endblock %}
